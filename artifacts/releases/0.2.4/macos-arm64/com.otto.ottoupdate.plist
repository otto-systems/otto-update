<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.otto.ottoupdate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/ottoupdate-server</string>
    <string>--config</string>
    <string>/usr/local/etc/ottoupdate/config.toml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/ottoupdate</string>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/ottoupdate.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/ottoupdate.err.log</string>
</dict>
</plist>
