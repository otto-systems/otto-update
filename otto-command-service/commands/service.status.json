{
  "name": "service.status",
  "description": "Query OttoUpdate service status.",
  "parameters": { "type": "object", "properties": {} },
  "returnType": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" } } },
  "errorTypes": ["UnsupportedPlatformError", "ServiceCommandError"],
  "permissions": ["service:read"],
  "routing": {
    "handlerModule": "serviceStatus.mjs",
    "handlerExport": "handle",
    "exposedAs": ["cli", "api"],
    "http": { "method": "GET", "path": "/v1/commands/service/status" }
  }
}
